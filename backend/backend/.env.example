DATABASE_URL=postgres://minipay:CHANGE_ME@localhost:5432/minipay
JWT_SECRET=generate-a-random-string-of-at-least-32-characters
PORT=4000

# Encrypts 2FA secrets at rest. Generate once (openssl rand -base64 48) and keep it stable.
# If unset, a key is derived from JWT_SECRET, so rotating JWT_SECRET would invalidate every 2FA enrolment.
DATA_ENCRYPTION_KEY=

# Number of reverse proxies in front of this app (Vercel rewrite + Render edge = 2). Without it every client looks like the proxy
# and IP-based limits/audit entries collapse. Too HIGH a number lets clients spoof their IP: verify with a real login and check audit_logs.ip.
TRUST_PROXY=2

# Make administrators enrol 2FA before /api/admin works.
REQUIRE_ADMIN_MFA=false

# Optional overrides (paise unless noted). Defaults shown.
# LIMIT_PER_TRANSFER_PAISE=10000000       # Rs 1,00,000 per payment
# LIMIT_DAILY_SEND_PAISE=20000000         # Rs 2,00,000 per rolling 24h
# LIMIT_NEW_ACCOUNT_DAILY_PAISE=1000000   # Rs 10,000 per 24h while the account is young
# NEW_ACCOUNT_HOURS=72
# LIMIT_HOURLY_TRANSFERS=20
# LIMIT_DAILY_FUNDING_PAISE=20000000
# STEP_UP_THRESHOLD_PAISE=500000          # payments >= Rs 5,000 always need the PIN
# RISK_CHALLENGE_SCORE=40                 # 0-100: at or above -> PIN required
# RISK_BLOCK_SCORE=80                     # at or above -> payment blocked and queued for review
# RATE_SEND_PER_MIN=10
# RATE_FUNDING_PER_MIN=10
# RATE_SEARCH_PER_MIN=30
# RATE_SENSITIVE_PER_15MIN=10
